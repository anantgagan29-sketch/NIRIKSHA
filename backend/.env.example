# NIRIKSHA backend — environment
# Copy to .env and fill in. Never commit the filled-in file.

# Google Gemini API key. Required: the vision parsing and readability analysis
# both call Gemini, and the app refuses to start without it.
GEMINI_API_KEY=

# Browsers that may call this API, comma separated. No wildcard: requests are
# same-site and credentialed, so the origins are listed explicitly.
# Add your deployed frontend origin here in production.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180

# Where uploaded product images are written, relative to the backend root.
UPLOAD_DIR=uploads

# Server-side upload ceiling in bytes. Default 10 MB.
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------
# Vision models
# ---------------------------------------------------------------
# Tried in order, fastest first. The free tier meters requests per model per
# day, so several models means a day's demonstrations do not end when the
# first allowance is spent.
# AI_MODELS=gemini-3.5-flash,gemini-3.7-flash,gemini-2.5-flash,gemini-3.8-flash

# How long a model is left alone after refusing, in seconds. A spent daily
# allowance is not worth retrying; a 503 is.
# QUOTA_COOLDOWN_SECONDS=3600
# RATE_LIMIT_COOLDOWN_SECONDS=60
# UNAVAILABLE_COOLDOWN_SECONDS=45

# The readability pass is a second vision call on the same image. It adds
# per-declaration confidence figures and does not change the compliance
# outcome. Off by default: an inspection then costs one request, not two.
# ENABLE_READABILITY=false

# Identical images are answered from the store instead of being sent again.
# SCAN_CACHE_ENABLED=true
# SCAN_CACHE_TTL_SECONDS=86400
# SCAN_CACHE_MAX_ENTRIES=200
