# NIRIKSHA frontend — environment
# Copy to .env.local. Vite only exposes variables prefixed with VITE_.

# Base URL of the NIRIKSHA API. Leave EMPTY to run on local demonstration data.
#   development : VITE_API_BASE_URL=http://localhost:8000
#   production  : VITE_API_BASE_URL=https://api.niriksha.example
VITE_API_BASE_URL=http://localhost:8000

# Optional escape hatch. When "true", recognition and the compliance rules run
# in the browser (Tesseract plus the local rule pack in src/engine) even though
# an API is configured — useful offline, on a poor connection, or while the
# backend is down. Leave "false" so the backend does the work.
VITE_FORCE_CLIENT_PIPELINE=false

# Supabase, for real accounts. Leave both empty to fall back to the local
# account store (accounts kept in this browser only).
#
# Both values come from your project's Settings -> API. Use the anon /
# publishable key — NOT the service_role key, which bypasses row-level
# security and must never reach a browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
